+<script id="by38-home-logout-bridge">
+/* Bind the homepage button to the existing account signout action, without
+   creating a second auth client or reading unverified local credentials. */
+(function(){'use strict';
+ const button=document.getElementById('by38HomeSignout');
+ const member=document.getElementById('by33Member');
+ const home=document.getElementById('cityHome');
+ const existing=document.getElementById('by33Signout');
+ if(!button||!member||!home||!existing)return;
+ const sync=function(){
+  const verifiedMemberVisible=!member.hidden;
+  const homeVisible=!home.hidden;
+  button.hidden=!(verifiedMemberVisible&&homeVisible);
+  if(button.hidden)button.disabled=false;
+ };
+ const observer=new MutationObserver(sync);
+ observer.observe(member,{attributes:true,attributeFilter:['hidden']});
+ observer.observe(home,{attributes:true,attributeFilter:['hidden']});
+ button.addEventListener('click',function(){
+  if(button.disabled||button.hidden||member.hidden)return;
+  button.disabled=true;
+  existing.click();
+  // The existing auth handler updates member.hidden after signing out.
+  queueMicrotask(sync);
+ });
+ sync();
+})();
+</script>
